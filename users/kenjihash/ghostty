# Solarized Dark (Higher Contrast) — matches the Mac terminal + nvim solarized.
theme = Solarized Dark Higher Contrast
# JetBrainsMono Nerd Font — same JetBrains Mono letterforms as the Mac, but the
# Nerd-Font-patched build so ICONS live in the same metric-matched font (the
# "Mono" variant sizes each icon to exactly one terminal cell). Plain "JetBrains
# Mono" forced icons onto a mismatched fallback font and they rendered ugly.
font-family = JetBrainsMono Nerd Font Mono
# ghostty doesn't follow the VM's (0mm-EDID) DPI, so size explicitly. Tune to taste.
font-size = 22

# No GTK titlebar/tab bar — i3 tiles the window, so the decoration just wastes
# vertical space.
window-decoration = false
